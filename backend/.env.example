# OmniSight backend environment — NAMES ONLY. Fill real values in the Render
# dashboard (Environment tab). NEVER commit real values to git.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Supabase service-role key (Project Settings → API). Server-side ONLY.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase JWT secret (Project Settings → API → JWT Secret). Used to verify
# user access tokens.
SUPABASE_JWT_SECRET=
# Fernet encryption key for stored exchange credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRED_ENC_KEY=
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=https://omnisight27.github.io
